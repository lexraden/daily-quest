{
  "name": "UserQuestData",
  "type": "object",
  "properties": {
    "quest_data": {
      "type": "object",
      "description": "\u041a\u0430\u0441\u0442\u043e\u043c\u043d\u044b\u0435 \u043a\u0432\u0435\u0441\u0442\u044b \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u043f\u043e \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f\u043c"
    },
    "category_levels": {
      "type": "object",
      "description": "\u0423\u0440\u043e\u0432\u043d\u0438 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0439 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f"
    },
    "category_total_completed": {
      "type": "object",
      "description": "\u0412\u0441\u0435\u0433\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u043e \u043a\u0432\u0435\u0441\u0442\u043e\u0432 \u043f\u043e \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f\u043c"
    },
    "total_completed": {
      "type": "number",
      "default": 0,
      "description": "\u0412\u0441\u0435\u0433\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u043e \u043a\u0432\u0435\u0441\u0442\u043e\u0432"
    },
    "streak": {
      "type": "number",
      "default": 0,
      "description": "\u0422\u0435\u043a\u0443\u0449\u0430\u044f \u0441\u0435\u0440\u0438\u044f \u0434\u043d\u0435\u0439"
    },
    "last_completed_date": {
      "type": "string",
      "description": "\u0414\u0430\u0442\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u043e\u0433\u043e \u043a\u0432\u0435\u0441\u0442\u0430"
    },
    "completion_history": {
      "type": "object",
      "description": "\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u043a\u0432\u0435\u0441\u0442\u043e\u0432 \u043f\u043e \u0434\u0430\u0442\u0430\u043c"
    },
    "streak_freezes": {
      "type": "number",
      "default": 1,
      "description": "\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043e\u043a \u0441\u0435\u0440\u0438\u0438"
    },
    "journal_entries": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "\u0417\u0430\u043f\u0438\u0441\u0438 \u0436\u0443\u0440\u043d\u0430\u043b\u0430 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f"
    },
    "last_visit_date": {
      "type": "string",
      "description": "\u0414\u0430\u0442\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0432\u0438\u0437\u0438\u0442\u0430"
    },
    "onboarding_answers": {
      "type": "object",
      "description": "\u041e\u0442\u0432\u0435\u0442\u044b \u0438\u0437 \u043e\u043d\u0431\u043e\u0440\u0434\u0438\u043d\u0433\u0430"
    },
    "meal_history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u043f\u0440\u0438\u0451\u043c\u043e\u0432 \u043f\u0438\u0449\u0438 \u0441 \u043a\u0430\u043b\u043e\u0440\u0438\u044f\u043c\u0438 \u0438 \u043d\u0443\u0442\u0440\u0438\u0435\u043d\u0442\u0430\u043c\u0438"
    },
    "notification_settings": {
      "type": "object",
      "description": "\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439"
    },
    "calories_burned": {
      "type": "object",
      "description": "\u0421\u043e\u0436\u0436\u0451\u043d\u043d\u044b\u0435 \u043a\u0430\u043b\u043e\u0440\u0438\u0438 \u043f\u043e \u0434\u0430\u0442\u0430\u043c (\u0440\u0443\u0447\u043d\u043e\u0439 \u0432\u0432\u043e\u0434): {\"YYYY-MM-DD\": number}"
    },
    "trial_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp \u043a\u043e\u0433\u0434\u0430 \u043d\u0430\u0447\u0430\u043b\u0441\u044f 3-\u0434\u043d\u0435\u0432\u043d\u044b\u0439 free trial (\u043e\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u043e\u043d\u0431\u043e\u0440\u0434\u0438\u043d\u0433\u0430)"
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "\u0410\u043a\u0442\u0438\u0432\u043d\u0430 \u043b\u0438 Premium \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0430"
    }
  },
