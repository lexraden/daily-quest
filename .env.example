# ---------------------------------------------------------------------------
# dailyq-api service
# ---------------------------------------------------------------------------

# Railway injects this when the Postgres database is attached. Reference it in
# the dashboard as ${{Postgres.DATABASE_URL}} rather than pasting a literal.
DATABASE_URL=postgresql://user:pass@localhost:5432/dailyq

# Session signing. 32+ random bytes each, and different from one another.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Signs image URLs so <img> tags load without an Authorization header.
# Rotating this invalidates every photo URL already stored in meal_history —
# treat it as permanent once users have uploaded anything.
FILE_SIGNING_SECRET=

# Google OAuth client (Web application). Authorised JavaScript origins must
# include your Railway domain and http://localhost:5173 for local development.
# The SPA reads this same value from GET /api/auth/config, so it is set once
# here and never duplicated as a VITE_ build variable.
GOOGLE_CLIENT_ID=

# Set to 1 to let anyone with the URL create a throwaway account, for testing
# where Google sign-in is not reachable. Leave it off in production: each guest
# is a fresh trial, and a fresh trial can spend money on OpenAI.
GUEST_LOGIN_ENABLED=0

OPENAI_API_KEY=
# Model per job, so swapping one needs no code change.
OPENAI_MODEL_QUESTS=gpt-4o
OPENAI_MODEL_MEAL=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o

# Must sit inside the mounted Railway volume.
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=8388608

# Canonical URL of the deployment. Also used for the link in Telegram reminders.
APP_ORIGIN=https://your-app.up.railway.app

# Only needed when the web app is served from a different origin than the API
# (local development). Leave empty in production — the API serves the SPA.
CORS_ORIGINS=

# Per-user monthly ceiling on AI calls.
AI_MONTHLY_CALL_LIMIT=500

# Set to 0 to ignore trial and premium status on the AI endpoints, for testing.
# The monthly quota above still applies. Leave it on in production.
AI_GATE_ENABLED=1

# ---------------------------------------------------------------------------
# dailyq-reminders service (same repo, cron schedule, start command:
#   npm run reminders --workspace apps/api)
#
# This service needs DATABASE_URL, APP_ORIGIN, the VAPID pair and
# the Telegram bot token and username. It does not load the API's signing
# secrets, the OpenAI key, or the Telegram webhook secret — the webhook is the
# API's business — so do not copy those onto it.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Telegram bot, the third notification channel. Needed by BOTH services: the API
# links accounts and answers the bot's webhook, the reminders job sends.
#
# Create the bot with @BotFather, then:
#   1. Set the token and the username (without the @) below.
#   2. Invent a webhook secret — any 32+ random characters will do:
#        openssl rand -hex 32
#   3. Register the webhook once, with that same secret:
#        curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#             -H "Content-Type: application/json" \
#             -d '{"url":"https://your-app.up.railway.app/api/telegram/webhook",
#                  "secret_token":"<THE SECRET>",
#                  "allowed_updates":["message","pre_checkout_query"]}'
#
# `pre_checkout_query` is not optional once Pro can be bought: Telegram asks for
# approval on its own update type, and an allow-list without it means the
# approval is never requested, the ten-second window lapses and every checkout
# fails. A completed payment arrives inside a `message`, so that one covers it.
#
# The secret is the webhook's only door — Telegram has no bearer token to
# present, so it sends this back in a header and the route refuses anything
# else. With it unset the webhook refuses everyone, including Telegram.
#
# Leave all of it empty and the app runs without the channel: the profile hides
# the button and reminders go by push.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Which of the two services this container is.
#
# Only the reminders service sets it, and only as a second route to the same
# answer: the primary one is that service's config-as-code path pointing at
# railway.reminders.json. Set it there and the cron container runs the job
# instead of the API, whatever the Railway setting says.
#
#   SERVICE_ROLE=reminders   -> run the reminders job and exit
#   unset, or anything else  -> run the API
# ---------------------------------------------------------------------------
SERVICE_ROLE=

# ---------------------------------------------------------------------------
# What Pro costs, in Telegram Stars, and what one purchase buys.
#
# Both are read when an invoice is minted, so changing them needs a restart but
# not a release, and it never touches what someone already paid for — that is in
# the payments table. Payments ride the same bot as the notifications above:
# with no TELEGRAM_BOT_TOKEN there is nothing to buy with, and the Pro screen
# says payments are not set up rather than offering a button that fails.
# ---------------------------------------------------------------------------
# One star by default: cheap enough to test the whole path for real.
PRO_PRICE_STARS=1
PRO_PERIOD_DAYS=30

# ---------------------------------------------------------------------------
# Web Push. Needed by BOTH services: the API hands the public key to browsers
# when they subscribe, the reminders job signs with the private one.
#
# Generate the pair once:
#   npx web-push generate-vapid-keys
#
# Then set the SAME pair on both services and do not change it. The public key
# is baked into every subscription a browser holds, so a new pair silently stops
# every device already subscribed from ever receiving anything again.
#
# Leave them empty and the app runs without push: reminders go by Telegram,
# and the toggle in the profile reports that it is not configured.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push services can complain to. Must be mailto: or https:.
VAPID_SUBJECT=mailto:you@yourdomain.com

# ---------------------------------------------------------------------------
# apps/web build-time variables (baked into the bundle by Vite)
# ---------------------------------------------------------------------------
# Empty in production: the API serves the SPA from the same origin.
VITE_API_URL=
