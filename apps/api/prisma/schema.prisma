// DailyQ data model.
//
// The JSON columns mirror the shape the React app already reads and writes, so
// the frontend needed no reshaping during the Base44 cutover. `mealHistory` and
// `journalEntries` are unbounded arrays rewritten wholesale on every save —
// fine at current scale, worth normalising into their own tables later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  googleSub String   @unique @map("google_sub")
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  role      Role     @default(user)

  // Entitlement lives on the account: quest_data is deleted when a user resets
  // onboarding, which would otherwise hand out a fresh trial each time.
  trialStartedAt DateTime? @map("trial_started_at")
  // A grant with no end: the launch accounts, and anything handed out by
  // scripts/grantPro.ts. Outranks premiumUntil rather than being expressed
  // through it, so a comped account is never quietly turned off by a clock.
  isPremium      Boolean   @default(false) @map("is_premium")
  // Paid access, and when it runs out. Each payment extends it.
  premiumUntil   DateTime? @map("premium_until")

  // Which unlocked level avatar the user is wearing, as "level-<n>". Null means
  // avatarUrl is in charge — an uploaded photo always outranks the unlockables,
  // so earning a new one never silently replaces someone's own picture.
  avatarChoice String? @map("avatar_choice")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  questData     QuestData?
  files         File[]
  refreshTokens RefreshToken[]
  chatMessages  ChatMessage[]
  pushSubs      PushSubscription[]
  notifications Notification[]
  telegram      TelegramLink?
  payments      Payment[]
  mealPreviews  TelegramMealPreview[]

  @@map("users")
}

model QuestData {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  // Six categories x three levels, keyed by category name.
  questData              Json @default("{}") @map("quest_data")
  categoryLevels         Json @default("{}") @map("category_levels")
  categoryTotalCompleted Json @default("{}") @map("category_total_completed")
  // { "YYYY-MM-DD": [questId, ...] } in the user's local dates.
  completionHistory      Json @default("{}") @map("completion_history")
  caloriesBurned         Json @default("{}") @map("calories_burned")
  // Daily mood check-in: { "YYYY-MM-DD": { score: 1-5, note?: string, at: ISO } }
  moodLog                Json @default("{}") @map("mood_log")
  onboardingAnswers      Json @default("{}") @map("onboarding_answers")
  // { enabled, reminder_time, timezone, streak_warning, push_token }
  notificationSettings   Json @default("{}") @map("notification_settings")
  journalEntries         Json @default("[]") @map("journal_entries")
  mealHistory            Json @default("[]") @map("meal_history")

  totalCompleted Int @default(0) @map("total_completed")
  streak         Int @default(0)
  streakFreezes  Int @default(1) @map("streak_freezes")

  // Highest overall level the user has already been congratulated for. The
  // level itself is derived from totalCompleted on every write, so without this
  // the modal would reappear on every reload and on every other device.
  celebratedLevel Int @default(0) @map("celebrated_level")

  // "YYYY-MM-DD" strings: these are local calendar days, not instants.
  lastCompletedDate String? @map("last_completed_date")
  lastVisitDate     String? @map("last_visit_date")

  // The local day a reminder was last claimed for. The reminders job claims it
  // with a conditional UPDATE before sending, so a run that overlaps another —
  // a retry, a manual trigger, a second replica — sends nothing.
  lastReminderDay String? @map("last_reminder_day")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quest_data")
}

model File {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  path      String // relative to UPLOAD_DIR
  mimeType  String   @map("mime_type")
  bytes     Int
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("files")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/**
 * The coach conversation, oldest first.
 *
 * Only the tail is ever sent to the model — a chat that grew without bound
 * would make every reply more expensive than the last — and the table is
 * trimmed to the same window on write, so the row count per user is capped
 * rather than merely queried with a limit.
 */
model ChatMessage {
  id     String @id @default(cuid())
  userId String @map("user_id")

  // 'user' or 'assistant'. Not an enum: the set is settled here, and a
  // migration to add a role would be more ceremony than the check is worth.
  role    String
  content String @db.Text

  // The action offered alongside an assistant reply, if any:
  // { kind: 'quest' | 'complete', category, level, name?, emoji? }.
  // Nothing is applied from here — the client calls the ordinary quest
  // endpoints once the user taps, so the chat route never writes quest data.
  proposal Json?

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_messages")
}

/**
 * One browser's permission to be notified.
 *
 * Per device, not per account: a phone and a laptop each hand back their own
 * endpoint, and a reminder should reach whichever is to hand. The endpoint is
 * the identity — reinstalling the app or clearing site data mints a new one and
 * silently abandons the old, so the sender deletes any the push service reports
 * as gone rather than retrying them forever.
 */
model PushSubscription {
  id     String @id @default(cuid())
  userId String @map("user_id")

  // The push service's URL for this browser. Unique across users: the same
  // endpoint cannot belong to two accounts, and re-subscribing on one device
  // updates the row rather than adding another.
  endpoint String @unique

  // The browser's keys for encrypting the payload to it.
  p256dh String
  auth   String

  createdAt DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Per-user monthly AI spend guard. Rows are cheap; one per user per period.
model AiUsage {
  id     String @id @default(cuid())
  userId String @map("user_id")
  period String // "YYYY-MM"
  calls  Int    @default(0)

  @@unique([userId, period])
  @@map("ai_usage")
}

/**
 * The in-app notification log.
 *
 * Push and email are fire-and-forget: a phone that was off, a permission never
 * granted, a browser that dropped the subscription — and the reminder simply
 * never happened. This table is the channel that cannot be missed, so the app
 * can show what it tried to tell someone whether or not the phone rang.
 *
 * The text is stored rendered rather than as a template, in the language the
 * user was using at the time. That is deliberate: a log records what was said,
 * so switching language later leaves old entries alone instead of retelling
 * them. `data` carries the numbers behind the line for anything the UI wants to
 * do with them.
 */
model Notification {
  id     String @id @default(cuid())
  userId String @map("user_id")

  // 'reminder' | 'streak_warning' | 'level_up' | 'streak_milestone' |
  // 'freeze_used' | 'streak_lost'. Not an enum for the same reason as
  // ChatMessage.role: adding a kind should not need a migration.
  kind  String
  title String
  body  String @db.Text

  // { level?, streak?, freezes? } — whatever the line was rendered from.
  data Json?

  readAt DateTime? @map("read_at")

  /**
   * What makes writing one idempotent.
   *
   * Null means "always insert" — an event that genuinely can happen twice. A
   * value means at most one row per user per key, enforced by the database
   * rather than by checking first: the reminders job claims a day and writes
   * `reminder-2026-09-23`, so a retry, a manual run, or a second replica adds
   * nothing. Postgres treats NULLs as distinct, so the unique index leaves the
   * unkeyed rows alone.
   */
  dedupeKey String? @map("dedupe_key")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("notifications")
}

/**
 * A user's Telegram chat, and the pending code that links it.
 *
 * One row per user, created when they ask to connect and filled in by the
 * webhook when the bot hears from them. The two states are worth being clear
 * about: a row with a `codeHash` and no `chatId` is an invitation nobody has
 * accepted yet, and a row with a `chatId` is a live channel.
 *
 * The code is hashed rather than stored, for the same reason refresh tokens are.
 * It is short-lived and single-use, but while it is live it is enough to point
 * someone else's reminders at your own chat, and a code that only exists as a
 * hash cannot be read out of a backup.
 */
model TelegramLink {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  /**
   * Telegram's id for the private chat with this user, as a string.
   *
   * Numeric in the API and within int64, but kept as text: Prisma maps BigInt to
   * JavaScript BigInt, which does not survive JSON.stringify, and nothing here
   * does arithmetic on it.
   */
  chatId String? @unique @map("chat_id")

  /** Whatever the bot knows them as, for showing which account is connected. */
  username String?

  // SHA-256 of the one-time /start payload. Null once it has been used.
  codeHash  String?   @unique @map("code_hash")
  codeExpiresAt DateTime? @map("code_expires_at")

  linkedAt  DateTime? @map("linked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_links")
}

/**
 * A meal the bot has read off a photo and is waiting on a Save or Cancel for.
 *
 * In the database rather than in memory because the tap arrives on a separate
 * webhook call — after a restart, or on another instance — and because claiming
 * it has to be one statement for a double tap not to save the meal twice.
 *
 * One per chat: a new photo replaces the pending one, so the older preview's
 * buttons stop matching anything. The token in the buttons is stored only as a
 * hash, like the /start code, and it is the whole proof — the account comes
 * from this row, never from what the button carries.
 */
model TelegramMealPreview {
  id     String @id @default(cuid())
  chatId String @unique @map("chat_id")
  userId String @map("user_id")

  /** Telegram's id for whoever sent the photo; only they can answer it. */
  fromId String @map("from_id")

  tokenHash String   @unique @map("token_hash")
  /** Already validated against mealBody; saved as is. */
  meal      Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("telegram_meal_previews")
}

/**
 * One completed purchase.
 *
 * Kept as a ledger rather than folded into the user row, because `premium_until`
 * alone cannot answer who paid what — and a refund, which Telegram allows for
 * Stars, needs the charge id to act on.
 */
model Payment {
  id String @id @default(cuid())

  userId String @map("user_id")

  /** 'telegram_stars' today; the column exists so a second one can be added. */
  provider String

  /**
   * The provider's own id for the charge. Unique, and that is the whole
   * idempotency mechanism: Telegram redelivers a webhook it did not hear a 200
   * for, and a redelivered successful_payment must not buy a second month.
   */
  chargeId String @unique @map("charge_id")

  /** In the provider's smallest unit. For Stars that is one star. */
  amount   Int
  currency String

  /** How much access this bought, so the ledger explains the expiry. */
  days Int

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("payments")
}
