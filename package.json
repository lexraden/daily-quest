{
  "name": "dailyq",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "build": "npm run build --workspace apps/web && npm run build --workspace apps/api",
    "build:web": "npm run build --workspace apps/web",
    "build:api": "npm run build --workspace apps/api",
    "lint": "npm run lint --workspace apps/web",
    "start": "npm run start --workspace apps/api",
    "reminders": "npm run reminders --workspace apps/api",
    "test": "npm test --workspace apps/api",
    "typecheck": "npm run typecheck --workspace apps/api"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.46",
    "@base44/vite-plugin": "^1.0.34"
  }
}
